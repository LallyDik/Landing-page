---
import type { SiteContent } from '../data/content'
import PersonSchema from '../components/PersonSchema.astro'
import '../styles/global.css'

interface Props {
  content: SiteContent
}

const { content } = Astro.props
const site = 'https://leahdick-dev.com'
const canonical = content.lang === 'he' ? `${site}/` : `${site}/en`
---

<!doctype html>
<html lang={content.lang} dir={content.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="he" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en`} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <PersonSchema content={content} />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="cursor-glow" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>
    <main>
      <slot />
    </main>

    <script is:inline>
      ;(function () {
        var root = document.documentElement
        root.classList.add('js')
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
        var fine = matchMedia('(pointer: fine)').matches

        // Scroll progress bar.
        var bar = document.querySelector('.scroll-progress')
        function onScroll() {
          var max = root.scrollHeight - root.clientHeight
          var p = max > 0 ? root.scrollTop / max : 0
          if (bar) bar.style.transform = 'scaleX(' + p + ')'
        }
        addEventListener('scroll', onScroll, { passive: true })
        onScroll()

        if (reduce) return

        // Type the hero kicker out like a terminal (the caret keeps blinking).
        var hk = document.querySelector('.hero .kicker')
        if (hk) {
          var full = hk.textContent
          hk.textContent = ''
          var ci = 0
          ;(function type() {
            hk.textContent = full.slice(0, ci++)
            if (ci <= full.length) setTimeout(type, 45)
          })()
        }

        // Staggered scroll reveal. A manual position check on scroll is used
        // (not IntersectionObserver) so it fires reliably, and a safety net
        // reveals anything left after a few seconds — content is never stuck
        // hidden. Classes are removed once the animation ends so the element's
        // transform is free again (e.g. for card tilt).
        var targets = [].slice.call(
          document.querySelectorAll(
            '.band:not(.hero) .section-head, .band:not(.hero) .grid > *, .band:not(.hero) .entries > *, .band:not(.hero) .links > *, .band:not(.hero) .entry'
          )
        )
        targets.forEach(function (el) {
          el.classList.add('reveal')
        })
        function reveal(el) {
          if (el.classList.contains('in')) return
          var i = 0,
            s = el
          while ((s = s.previousElementSibling)) i++
          el.style.animationDelay = Math.min(i, 6) * 65 + 'ms'
          el.addEventListener(
            'animationend',
            function () {
              el.classList.remove('reveal', 'in')
              el.style.animationDelay = ''
            },
            { once: true }
          )
          el.classList.add('in')
        }
        function check() {
          var vh = innerHeight
          targets = targets.filter(function (el) {
            var r = el.getBoundingClientRect()
            if (r.top < vh * 0.9 && r.bottom > 0) {
              reveal(el)
              return false
            }
            return true
          })
        }
        addEventListener('scroll', check, { passive: true })
        addEventListener('resize', check, { passive: true })
        check()
        // Safety net: never leave anything hidden if scroll events go missing.
        setTimeout(function () {
          targets.forEach(reveal)
          targets = []
        }, 4000)

        if (!fine) return

        // Holographic glow trailing the cursor.
        var glow = document.querySelector('.cursor-glow')
        var gx = innerWidth / 2,
          gy = innerHeight / 2,
          tx = gx,
          ty = gy
        addEventListener('pointermove', function (e) {
          tx = e.clientX
          ty = e.clientY
          if (glow) glow.style.opacity = '1'
        })
        ;(function loop() {
          gx += (tx - gx) * 0.15
          gy += (ty - gy) * 0.15
          if (glow) glow.style.transform = 'translate(' + gx + 'px,' + gy + 'px) translate(-50%,-50%)'
          requestAnimationFrame(loop)
        })()

        // Spotlight following the cursor inside every card.
        document.querySelectorAll('.capability, .project-card').forEach(function (card) {
          card.addEventListener('pointermove', function (e) {
            var r = card.getBoundingClientRect()
            card.style.setProperty('--mx', e.clientX - r.left + 'px')
            card.style.setProperty('--my', e.clientY - r.top + 'px')
          })
        })

        // 3D tilt on project cards.
        document.querySelectorAll('.project-card').forEach(function (card) {
          card.addEventListener('pointermove', function (e) {
            var r = card.getBoundingClientRect()
            var px = (e.clientX - r.left) / r.width - 0.5
            var py = (e.clientY - r.top) / r.height - 0.5
            card.style.transform =
              'perspective(800px) rotateX(' + -py * 5 + 'deg) rotateY(' + px * 5 + 'deg) translateY(-4px)'
          })
          card.addEventListener('pointerleave', function () {
            card.style.transform = ''
          })
        })

        // Custom cursor ring: lerp-follows, grows over interactive elements.
        var ring = document.querySelector('.cursor-ring')
        var rx = innerWidth / 2,
          ry = innerHeight / 2
        addEventListener('pointermove', function (e) {
          if (ring) ring.style.opacity = '1'
        })
        ;(function ringLoop() {
          rx += (tx - rx) * 0.2
          ry += (ty - ry) * 0.2
          if (ring) ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px)'
          requestAnimationFrame(ringLoop)
        })()
        document.querySelectorAll('a, button, .card, .btn').forEach(function (el) {
          el.addEventListener('pointerenter', function () {
            if (ring) ring.classList.add('big')
          })
          el.addEventListener('pointerleave', function () {
            if (ring) ring.classList.remove('big')
          })
        })

        // Holographic confetti when the CV is downloaded.
        var cv = document.querySelector('.cv')
        if (cv)
          cv.addEventListener('click', function () {
            var colors = ['#f25caf', '#8e63f0', '#3fd0d0', '#efce55']
            var r = cv.getBoundingClientRect()
            for (var k = 0; k < 18; k++) {
              var p = document.createElement('div')
              p.className = 'confetti'
              p.style.left = r.left + r.width / 2 + 'px'
              p.style.top = r.top + 'px'
              p.style.background = colors[k % 4]
              var ang = Math.random() * Math.PI
              var dist = 70 + Math.random() * 140
              p.style.setProperty('--dx', -Math.cos(ang) * dist + 'px')
              p.style.setProperty('--dy', -Math.abs(Math.sin(ang)) * dist - 30 + 'px')
              document.body.appendChild(p)
              ;(function (el) {
                setTimeout(function () {
                  el.remove()
                }, 950)
              })(p)
            }
          })

        // Magnetic pull on the gradient buttons.
        document.querySelectorAll('.btn--solid, .cv').forEach(function (btn) {
          btn.addEventListener('pointermove', function (e) {
            var r = btn.getBoundingClientRect()
            btn.style.transform =
              'translate(' +
              (e.clientX - (r.left + r.width / 2)) * 0.25 +
              'px,' +
              (e.clientY - (r.top + r.height / 2)) * 0.4 +
              'px)'
          })
          btn.addEventListener('pointerleave', function () {
            btn.style.transform = ''
          })
        })
      })()
    </script>
  </body>
</html>
