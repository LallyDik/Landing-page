---
import type { SiteContent } from '../data/content'
import SectionHead from './SectionHead.astro'

interface Props {
  content: SiteContent
}

const { content } = Astro.props
---

<section id="stack" class="band band--ink">
  <div class="wrap">
    <SectionHead num="04" title={content.tech.heading} />

    <div class="grid">
      {
        content.tech.groups.map((group) => (
          <div class="tech-group">
            <h3>{group.label}</h3>
            <ul class="tags">
              {group.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Reference only — the stack is already stated in the hero and on every
     project card, so this stays compact and quiet. */
  .grid {
    display: grid;
    gap: 1.75rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .tech-group {
    text-align: start;
  }

  h3 {
    margin-block: 0 0.8rem;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    padding-block-end: 0.6rem;
    border-block-end: 1px solid var(--line-on-ink);
  }
</style>
