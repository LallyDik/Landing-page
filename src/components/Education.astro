---
import type { SiteContent } from '../data/content'
import SectionHead from './SectionHead.astro'

interface Props {
  content: SiteContent
}

const { content } = Astro.props
---

<section id="education" class="band band--ink">
  <div class="wrap">
    <SectionHead num="05" title={content.education.heading} />

    <div class="entry">
      <p class="period">{content.education.period}</p>
      <h3>{content.education.institution}</h3>
      <p class="detail">{content.education.detail}</p>
    </div>
  </div>
</section>

<style>
  .entry {
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: 1.25rem;
    max-width: 60ch;
  }

  .period {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--cream-muted);
    letter-spacing: 0.04em;
  }

  h3 {
    margin-block: 0.35rem 0.6rem;
    font-size: 1.2rem;
  }

  .detail {
    margin: 0;
    color: var(--cream-muted);
    font-size: 0.94rem;
    max-width: none;
  }
</style>
