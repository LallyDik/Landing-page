---
import type { Project } from '../data/content'

interface Props {
  project: Project
  opensInNewTab: string
  repoLabel: string
  contributionLabel: string
  viewLabel: string
}

const { project, opensInNewTab, repoLabel, contributionLabel, viewLabel } = Astro.props
const isLead = project.scale === 'lead'
---

<article class:list={['project-card', 'card', project.scale]}>
  <img
    class:list={['cover', { diagram: project.imageIsDiagram }]}
    src={project.image}
    alt=""
    width="760"
    height="460"
    loading="lazy"
    decoding="async"
  />

  <div class="body">
    <h3>{project.name}</h3>
    <p class="description">{project.description}</p>

    {
      isLead && (
        <div class="contribution">
          <p class="contribution-label">{contributionLabel}</p>
          <p class="contribution-text">{project.contribution}</p>
        </div>
      )
    }

    <ul class="tags">
      {project.tech.map((tech) => <li class="tag">{tech}</li>)}
    </ul>

    <div class="links">
      <a class="primary" href={project.url} target="_blank" rel="noopener noreferrer">
        {viewLabel} <span class="arrow" aria-hidden="true">↗</span>
        <span class="visually-hidden">({opensInNewTab})</span>
      </a>

      {
        project.repoUrl && (
          <a class="repo-link" href={project.repoUrl} target="_blank" rel="noopener noreferrer">
            {repoLabel} <span class="arrow" aria-hidden="true">↗</span>
            <span class="visually-hidden">({opensInNewTab})</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    background: #f6f2fb;
    transition: border-color 200ms ease;
  }

  .project-card:hover {
    border-color: var(--accent);
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 76 / 46;
    object-fit: cover;
    object-position: top;
    border-block-end: 1px solid var(--line-on-cream);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* A restrained zoom is the one motion the cover carries. */
  .project-card:hover .cover {
    transform: scale(1.03);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: var(--space-card);
    flex-grow: 1;
  }

  h3 {
    margin: 0;
    font-size: var(--step-project);
    letter-spacing: -0.01em;
  }

  .description {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    max-width: 52ch;
  }

  /* "What I built" — the recruiter-facing answer, set apart from the
     product description by an accent rule rather than another box. */
  .contribution {
    margin-block-start: 0.35rem;
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: 1rem;
  }

  .contribution-label {
    margin: 0 0 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .contribution-text {
    margin: 0;
    font-size: 0.95rem;
    max-width: 62ch;
  }

  .tags {
    margin-block-start: auto;
    padding-block-start: 0.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-block-start: 0.5rem;
  }

  a {
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }

  a:hover {
    color: var(--accent);
  }

  /* The arrow nudges on hover — the second and last motion here. */
  .arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }

  a:hover .arrow {
    transform: translate(2px, -2px);
  }

  .repo-link {
    margin-inline-start: 0.9rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 1px solid var(--line-on-cream);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .repo-link:hover {
    color: var(--accent);
  }

  /* Lead cards: a large screenshot beside the text, so the product is seen
     before it is read. Below 900px every card stacks. */
  @media (min-width: 900px) {
    .project-card.lead {
      flex-direction: row;
    }

    .project-card.lead .cover {
      width: 56%;
      height: auto;
      aspect-ratio: auto;
      align-self: stretch;
      border-block-end: none;
      border-inline-end: 1px solid var(--line-on-cream);
    }

    /* Diagram covers are `contain`, not `cover`: cropping their edges would
       cut off the very pipeline they exist to show. Screenshot covers keep
       `cover`, where a top-crop is the right framing. */
    .project-card.lead .cover.diagram {
      object-fit: contain;
      object-position: center;
      background: #171320;
    }

    .project-card.lead .body {
      width: 44%;
      justify-content: center;
      padding: clamp(1.75rem, 3vw, 2.75rem);
    }

    .project-card.lead h3 {
      font-size: var(--step-project-lead);
    }
  }
</style>
