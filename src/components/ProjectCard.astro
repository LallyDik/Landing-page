---
import type { Project } from '../data/content'

interface Props {
  project: Project
  opensInNewTab: string
  repoLabel: string
  featured?: boolean
}

const { project, opensInNewTab, repoLabel, featured = false } = Astro.props
---

<article class:list={['project-card', 'card', { featured }]}>
  <img class="cover" src={project.image} alt="" width="760" height="460" loading="lazy" />

  <div class="body">
    <h3>{project.name}</h3>
    <p class="role">{project.role}</p>
    <p class="description">{project.description}</p>

    <ul class="tags">
      {project.tech.map((tech) => <li class="tag">{tech}</li>)}
    </ul>

    <div class="links">
      <a href={project.url} target="_blank" rel="noopener noreferrer">
        {project.name} <span aria-hidden="true">↗</span>
        <span class="visually-hidden">({opensInNewTab})</span>
      </a>

      {
        project.repoUrl && (
          <a class="repo-link" href={project.repoUrl} target="_blank" rel="noopener noreferrer">
            {repoLabel} <span aria-hidden="true">↗</span>
            <span class="visually-hidden">({opensInNewTab})</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    background: #f6f2fb;
    transition:
      transform 160ms ease,
      border-color 160ms ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 76 / 46;
    object-fit: cover;
    object-position: top;
    border-block-end: 1px solid var(--line-on-cream);
    transition: transform 0.5s ease;
  }

  .project-card:hover .cover {
    transform: scale(1.05);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem;
    flex-grow: 1;
  }

  h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .role {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .description {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    flex-grow: 1;
    max-width: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-block-start: 0.4rem;
  }

  a {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }

  a:hover {
    color: var(--accent);
  }

  .repo-link {
    margin-inline-start: 0.9rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 1px solid var(--line-on-cream);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .repo-link:hover {
    color: var(--accent);
  }

  /* Wide featured card: the lead project runs full width with the cover
     beside the text instead of above it, using the extra width. */
  @media (min-width: 700px) {
    .project-card.featured {
      flex-direction: row;
    }

    .project-card.featured .cover {
      width: 54%;
      height: auto;
      aspect-ratio: auto;
      align-self: stretch;
      border-block-end: none;
      border-inline-end: 1px solid var(--line-on-cream);
    }

    .project-card.featured .body {
      width: 46%;
      justify-content: center;
    }

    .project-card.featured h3 {
      font-size: 1.4rem;
    }
  }
</style>
