---
import type { Project } from '../data/content'

interface Props {
  project: Project
  opensInNewTab: string
  repoLabel: string
}

const { project, opensInNewTab, repoLabel } = Astro.props
---

<article class="project-card card">
  <img class="cover" src={project.image} alt="" width="760" height="460" loading="lazy" />

  <h3>{project.name}</h3>
  <p class="role">{project.role}</p>
  <p class="description">{project.description}</p>

  <ul class="tags">
    {project.tech.map((tech) => <li class="tag">{tech}</li>)}
  </ul>

  <div class="links">
    <a href={project.url} target="_blank" rel="noopener noreferrer">
      {project.name} <span aria-hidden="true">↗</span>
      <span class="visually-hidden">({opensInNewTab})</span>
    </a>

    {
      project.repoUrl && (
        <a class="repo-link" href={project.repoUrl} target="_blank" rel="noopener noreferrer">
          {repoLabel} <span aria-hidden="true">↗</span>
          <span class="visually-hidden">({opensInNewTab})</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0;
    overflow: hidden;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 76 / 46;
    object-fit: cover;
    object-position: top;
    border-block-end: 1px solid var(--border);
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
    padding-inline: 1.5rem;
    padding-block-start: 0.4rem;
  }

  .role,
  .description,
  .tags,
  .links {
    padding-inline: 1.5rem;
  }

  .links {
    padding-block-end: 1.5rem;
  }

  .role {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 600;
    color: #c9b8f5;
  }

  .description {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-block-start: 0.4rem;
  }

  a {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
  }

  a:hover {
    text-decoration: underline;
  }

  .repo-link {
    margin-inline-start: 0.9rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 1px solid var(--border);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .repo-link:hover {
    color: var(--text);
  }
</style>
