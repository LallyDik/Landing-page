---
import type { SiteContent } from '../data/content'
import SectionHead from './SectionHead.astro'

interface Props {
  content: SiteContent
}

const { content } = Astro.props
---

<section id="experience" class="band band--ink">
  <div class="wrap">
    <SectionHead num="03" title={content.experience.heading} />

    <div class="entries">
      {
        content.experience.items.map((entry) => (
          <article class="experience-entry">
            <p class="period">{entry.period}</p>
            <h3>
              {entry.role} · <span class="org">{entry.org}</span>
            </h3>
            <ul>
              {entry.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .entries {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 760px) {
    .entries {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .experience-entry {
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: 1.25rem;
  }

  .period {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--cream-muted);
    letter-spacing: 0.04em;
  }

  h3 {
    margin-block: 0.35rem 0.85rem;
    font-size: 1.2rem;
  }

  .org {
    color: var(--accent);
  }

  ul {
    margin: 0;
    padding-inline-start: 1.1rem;
    color: var(--cream-muted);
    font-size: 0.94rem;
  }

  li {
    margin-block-end: 0.4rem;
  }
</style>
