---
import type { SiteContent } from '../data/content'
import SectionHead from './SectionHead.astro'
import { contactIcons } from '../data/icons'

interface Props {
  content: SiteContent
}

const { content } = Astro.props

const isExternal = (href: string) => href.startsWith('http')
---

<section id="contact" class="band band--ink">
  <div class="wrap">
    <SectionHead num="06" title={content.contact.heading} />

    <ul class="links">
      {
        content.contact.links.map((link) => (
          <li>
            <a
              class="card"
              href={link.href}
              target={isExternal(link.href) ? '_blank' : undefined}
              rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
            >
              <span class="icon" aria-hidden="true" set:html={contactIcons[link.kind]} />
              <span class="label">{link.label}</span>
              {isExternal(link.href) && (
                <span class="visually-hidden">({content.opensInNewTab})</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <a class="cv" href={content.contact.cvHref} download>
      {content.contact.cvLabel}
    </a>
  </div>
</section>

<style>
  .links {
    list-style: none;
    padding: 0;
    margin: 0 0 2.25rem;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  /* Pearl cards on the deep base; reset --accent to the deep violet so the
     icon stays legible on the light card surface. */
  .links a {
    --accent: #7b3fe4;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-decoration: none;
    padding: 1.1rem;
    font-weight: 600;
    word-break: break-word;
    background: var(--cream);
    color: var(--ink);
    border: 1px solid var(--cream);
    border-radius: var(--radius);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .links a:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .icon {
    display: inline-flex;
    color: var(--accent);
    flex-shrink: 0;
  }

  /* The iridescent gradient — the signature — as the primary CTA fill. */
  .cv {
    display: inline-block;
    text-decoration: none;
    background: var(--iridescent);
    color: #171320;
    font-weight: 600;
    border-radius: 999px;
    padding: 0.85rem 2.1rem;
    transition: transform 160ms ease;
  }

  .cv:hover {
    transform: translateY(-2px);
  }
</style>
