---
import type { SiteContent } from '../data/content'
import { contactIcons } from '../data/icons'

interface Props {
  content: SiteContent
}

const { content } = Astro.props

const isExternal = (href: string) => href.startsWith('http')
const email = content.contact.links.find((l) => l.kind === 'email')
---

<section id="contact" class="band band--ink">
  <div class="wrap">
    <h2 class="prompt">{content.contact.prompt}</h2>

    {
      email && (
        <a class="cta" href={email.href}>
          {content.contact.ctaLabel} <span class="arrow" aria-hidden="true">→</span>
        </a>
      )
    }

    <ul class="links">
      {
        content.contact.links.map((link) => (
          <li>
            <a
              href={link.href}
              target={isExternal(link.href) ? '_blank' : undefined}
              rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
            >
              <span class="icon" aria-hidden="true" set:html={contactIcons[link.kind]} />
              <span class="label">{link.label}</span>
              {isExternal(link.href) && (
                <span class="visually-hidden">({content.opensInNewTab})</span>
              )}
            </a>
          </li>
        ))
      }
      <li>
        <a class="cv" href={content.contact.cvHref} download>
          <span class="label">{content.contact.cvLabel}</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  /* The section opens on the question itself — no numbered eyebrow, so the
     ask reads as an invitation rather than another catalogued block. */
  .prompt {
    margin: 0;
    font-size: var(--step-section);
    letter-spacing: -0.02em;
    max-width: 20ch;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--accent);
    border-block-end: 2px solid transparent;
    transition: border-color 200ms ease;
  }

  .cta:hover {
    border-block-end-color: var(--accent);
  }

  .arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }

  /* RTL flips the glyph itself, so nudge along the inline axis either way. */
  .cta:hover .arrow {
    transform: translateX(4px);
  }

  :global([dir='rtl']) .cta .arrow {
    scale: -1 1;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line-on-ink);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--cream-muted);
    font-size: 0.92rem;
    transition: color 160ms ease;
  }

  .links a:hover {
    color: var(--cream);
  }

  .icon {
    display: inline-flex;
    color: var(--accent);
    flex-shrink: 0;
  }

  .cv {
    font-weight: 600;
  }
</style>
