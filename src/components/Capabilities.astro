---
import type { SiteContent } from '../data/content'
import SectionHead from './SectionHead.astro'

interface Props {
  content: SiteContent
}

const { content } = Astro.props
---

<section id="capabilities" class="band band--ink">
  <div class="wrap">
    <SectionHead num="02" title={content.capabilities.heading} />

    <div class="grid">
      {
        content.capabilities.items.map((item) => (
          <article class:list={['capability', item.kind]}>
            <h3>{item.title}</h3>
            {item.kind === 'compact' && <p class="lead">{item.lead}</p>}
            <ul class="tags">
              {item.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 800px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* No card here — a rule and generous space carry the grouping instead,
     so boxes stay reserved for the project work. */
  .capability {
    border-block-start: 1px solid var(--line-on-ink);
    padding-block-start: 1.25rem;
  }

  h3 {
    margin-block: 0 0.6rem;
    font-size: var(--step-project);
    letter-spacing: -0.01em;
  }

  .lead {
    margin: 0 0 1.25rem;
    color: var(--cream-muted);
    font-size: 0.95rem;
    max-width: 34ch;
  }
</style>
