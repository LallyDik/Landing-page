---
import type { SiteContent } from '../data/content'
import ProjectCard from './ProjectCard.astro'

interface Props {
  content: SiteContent
}

const { content } = Astro.props
---

<section id="projects">
  <h2 class="section-heading">{content.projects.heading}</h2>

  <div class="grid">
    {
      content.projects.items.map((project, i) => (
        <ProjectCard
          project={project}
          opensInNewTab={content.opensInNewTab}
          repoLabel={content.projects.repoLabel}
          featured={i === 0}
        />
      ))
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  /* The lead project spans the full width as a featured card; the other four
     fall into a 2x2 grid beneath it, so no cell is ever left empty. */
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid > :global(.project-card.featured) {
      grid-column: 1 / -1;
    }
  }
</style>
