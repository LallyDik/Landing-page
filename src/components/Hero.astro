---
import type { SiteContent } from '../data/content'
import LangToggle from './LangToggle.astro'
import { contactIcons } from '../data/icons'

interface Props {
  content: SiteContent
}

const { content } = Astro.props
const isExternal = (href: string) => href.startsWith('http')
---

<header class="band band--cream hero">
  <LangToggle toggle={content.langToggle} />

  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="kicker">{content.hero.name}</p>
      <h1>
        <span class="visually-hidden">{content.hero.name} — </span>{content.hero.title}
      </h1>
      <p class="stack-line"><bdi dir="ltr">{content.hero.stackLine}</bdi></p>

      <div class="actions">
        <a class="btn btn--solid" href="#projects"><span>{content.hero.ctaProjects}</span></a>
        <a class="btn btn--ghost" href={content.contact.cvHref} download
          ><span>{content.hero.ctaCv}</span></a
        >
      </div>

      <ul class="stats">
        {content.hero.stats.map((stat) => <li>{stat}</li>)}
      </ul>

      <ul class="socials">
        {
          content.contact.links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-label={
                  isExternal(link.href) ? `${link.label} (${content.opensInNewTab})` : link.label
                }
                target={isExternal(link.href) ? '_blank' : undefined}
                rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
              >
                <span aria-hidden="true" set:html={contactIcons[link.kind]} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Signature: an abstract holographic panel — the iridescent colours as
         an oil-slick sheen, the one shimmering moment against the flat base. -->
    <div class="hero-art" aria-hidden="true">
      <div class="foil"></div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 860px) {
    .hero-grid {
      grid-template-columns: 1.55fr 1fr;
    }
  }

  .kicker {
    margin-block-end: 1.25rem;
  }

  /* The English headline is markedly longer than the Hebrew one, so the
     measure is set in ch (which tracks the font size) and kept wide enough
     that neither language runs past ~4 lines and pushes the CTAs under the
     fold. */
  h1 {
    font-size: var(--step-hero);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 0;
    max-width: 22ch;
  }

  /* The run is almost entirely Latin, so it is isolated as an LTR <bdi> —
     otherwise a dot-prefixed token like ".NET" reorders and renders as
     "NET.". The <p> itself keeps the page direction, so the line still
     aligns to the inline start in both languages. */
  .stack-line {
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 1.2vw, 0.95rem);
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    margin: 1.5rem 0 0;
    max-width: none;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-block-start: 2.25rem;
  }

  /* Three proof points, rule-separated rather than boxed. */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .stats li {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .stats li:not(:last-child)::after {
    content: '';
    width: 1px;
    height: 0.9rem;
    background: var(--line-on-cream);
  }

  .socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-on-cream);
    border-radius: 50%;
    color: var(--ink-muted);
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }

  .socials a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  /* Kept deliberately smaller than the text column: the headline and the
     proof points are the hero's job, and an oversized panel pushed the
     stats below the fold. */
  .hero-art {
    aspect-ratio: 1 / 1;
    max-width: 300px;
    inline-size: 100%;
    margin-inline: auto;
    perspective: 900px;
  }

  .foil {
    width: 100%;
    height: 100%;
    border-radius: 18px;
    box-shadow: 0 30px 70px rgba(23, 19, 32, 0.35);
    transform: rotate(3deg);
    position: relative;
    overflow: hidden;
    background: var(--ink);
  }

  /* The holographic colours live on an oversized layer that rotates slowly,
     so the oil-slick sweeps around the panel — the signature moment. */
  .foil::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200%;
    height: 200%;
    translate: -50% -50%;
    background: conic-gradient(from 0deg, #f25caf, #8e63f0, #3fd0d0, #efce55, #f25caf);
    animation: foil-spin 16s linear infinite;
  }

  /* Fixed sheen over the moving colour. */
  .foil::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 20% 15%, rgba(255, 255, 255, 0.55), transparent 55%),
      radial-gradient(90% 70% at 85% 90%, rgba(23, 19, 32, 0.35), transparent 60%);
    mix-blend-mode: soft-light;
  }

  @keyframes foil-spin {
    to {
      rotate: 360deg;
    }
  }

  /* Load-in: the hero text rises in sequence, the panel eases in after. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-text > * {
      animation: rise 0.7s both;
    }
    .kicker {
      animation-delay: 0.05s;
    }
    h1 {
      animation-delay: 0.13s;
    }
    .stack-line {
      animation-delay: 0.21s;
    }
    .actions {
      animation-delay: 0.29s;
    }
    .stats {
      animation-delay: 0.37s;
    }
    .socials {
      animation-delay: 0.45s;
    }
    .hero-art {
      animation: rise 0.9s 0.25s both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
